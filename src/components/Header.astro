---
import { withBase, stripBase, absUrl } from '@/utils/paths';
import { getLocaleFromUrl, getDict, getNav, getA11y } from '@/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = getLocaleFromUrl(Astro.url);
const dict = getDict(locale);
const nav = getNav(locale);
const a11y = getA11y(locale);
const pathname = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/' || normalized === '/en') {
    return pathname === normalized;
  }
  return pathname.startsWith(normalized);
}
---

<header class="site-header">
  <div class="container-narrow flex items-center justify-between gap-6 py-4">
    <a href={withBase(locale === 'en' ? '/en' : '/')} class="brand flex items-center gap-3" data-no-lang-switch>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32">
          <circle cx="16" cy="16" r="14" fill="var(--rose-200)"></circle>
          <path
            d="M10 18 Q13 22 16 16 Q19 11 22 14"
            stroke="var(--ink-900)"
            stroke-width="2"
            stroke-linecap="round"
            fill="none"
          ></path>
          <circle cx="11" cy="13" r="1.6" fill="var(--ink-900)"></circle>
          <circle cx="21" cy="13" r="1.6" fill="var(--ink-900)"></circle>
        </svg>
      </span>
      <span class="brand-name">{dict.siteName}</span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label={a11y.primaryNav}>
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'nav-link',
              isActive(item.href) && 'nav-link--active',
            ]}
            data-no-lang-switch
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label={a11y.toggleTheme}
        title={a11y.toggleTheme}
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <LanguageSwitcher variant="pill" />
      <button
        type="button"
        class="md:hidden p-2 rounded-full border border-cream-200"
        aria-label={a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-btn"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- 移动端菜单（默认隐藏） -->
  <div class="md:hidden hidden border-t border-cream-200" id="mobile-menu">
    <div class="container-narrow flex flex-col py-3 gap-1">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'nav-link',
              isActive(item.href) && 'nav-link--active',
            ]}
            data-no-lang-switch
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid theme('colors.cream.200');
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .brand {
    text-decoration: none;
    color: theme('colors.ink.900');
  }
  .brand-name {
    font-family: 'Noto Serif SC', 'Noto Serif', serif;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  .nav-link {
    padding: 0.5rem 0.9rem;
    border-radius: 9999px;
    color: theme('colors.ink.700');
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }
  .nav-link:hover {
    background: theme('colors.rose.50');
    color: theme('colors.ink.900');
  }
  .nav-link--active {
    background: theme('colors.rose.100');
    color: theme('colors.ink.900');
  }

  /* 主题切换按钮 */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid theme('colors.cream.200');
    background: transparent;
    color: theme('colors.ink.700');
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }
  .theme-toggle:hover {
    background: theme('colors.rose.50');
    color: theme('colors.ink.900');
    border-color: var(--rose-200);
    transform: rotate(12deg);
  }
  /* 浅色显示太阳、深色显示月亮 */
  .icon-moon { display: none; }
  [data-theme='dark'] .icon-sun { display: none; }
  [data-theme='dark'] .icon-moon { display: block; }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });

  // 主题切换：读写 data-theme + localStorage
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* 隐私模式等场景忽略写入失败 */
    }
  });
</script>
