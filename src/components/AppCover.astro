---
import { withBase } from '@/utils/paths';
import { hashToUnit, getPalette, getAccentColor } from '@/utils/hash';

interface Props {
  /** 唯一标识（slug）。相同 slug 永远生成相同的占位视觉 */
  slug: string;
  /** App 的 emoji icon，会以大字居中显示 */
  icon: string;
  /** App 中文/英文名（占位卡上叠的小字） */
  title: string;
  /** 系列（用于选配色），可选 */
  series?: string;
  /** 系列强调色（HEX），可选 */
  accentColor?: string;
  /** 1 = 卡片用 16:9；2 = 详情页 hero 用 3:2 */
  aspect?: 1 | 2;
  /** App Store 官方图标（站内逻辑路径），有则替换 emoji */
  iconImage?: string;
  /** 显式指定 cover 图片（src），优先于 SVG 占位 */
  src?: string;
  /** alt 文案 */
  alt?: string;
  class?: string;
}

const {
  slug,
  icon,
  title,
  series,
  accentColor,
  aspect = 1,
  src,
  iconImage,
  alt,
  class: className = '',
} = Astro.props;

const [bgA, bgB, accent] = getPalette(series);
const useAccent = accentColor ?? accent;

// 用 slug 哈希做稳定旋转 + 偏移，让每个 app 的占位图视觉不同
const seed = hashToUnit(slug);
const angle = 25 + seed * 40; // 25–65°
const offsetX = -10 + seed * 20; // -10–10%
const offsetY = -8 + (1 - seed) * 16;
const opa1 = 0.45 + seed * 0.3;
const opa2 = 0.3 + (1 - seed) * 0.3;

const aspectClass = aspect === 2 ? 'app-cover--3x2' : 'app-cover--16x9';
---

<div class={`app-cover ${aspectClass} ${className}`} aria-hidden={src ? undefined : 'true'}>
  {
    src ? (
      <img src={withBase(src)} alt={alt ?? title} class="cover-img" loading="lazy" />
    ) : (
      <svg viewBox="0 0 800 450" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id={`bg-${slug}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color={bgA} />
            <stop offset="100%" stop-color={bgB} />
          </linearGradient>
          <radialGradient id={`glow-${slug}`} cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color={useAccent} stop-opacity={opa1} />
            <stop offset="100%" stop-color={useAccent} stop-opacity="0" />
          </radialGradient>
          <linearGradient id={`shine-${slug}`} x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="white" stop-opacity="0.6" />
            <stop offset="100%" stop-color="white" stop-opacity="0" />
          </linearGradient>
        </defs>

        {/* 底色 */}
        <rect width="800" height="450" fill={`url(#bg-${slug})`} />

        {/* 主光晕 */}
        <circle
          cx="600"
          cy="180"
          r="280"
          fill={`url(#glow-${slug})`}
        />
        <circle
          cx="180"
          cy="340"
          r="200"
          fill={`url(#glow-${slug})`}
          opacity={opa2}
        />

        {/* 旋转条带（柔和弧线） */}
        <g transform={`rotate(${angle} 400 220)`}>
          <rect
            x={offsetX + 100}
            y={offsetY + 200}
            width="600"
            height="60"
            fill="white"
            opacity="0.18"
            rx="30"
          />
        </g>

        {/* 官方图标（有则用图标，否则用大 emoji）居中偏左 */}
        {iconImage ? (
          <g>
            <clipPath id={`icon-clip-${slug}`}>
              <rect x="185" y="125" width="190" height="190" rx="44" />
            </clipPath>
            <rect x="181" y="131" width="198" height="198" rx="46" fill="black" opacity="0.08" />
            <image
              href={withBase(iconImage)}
              x="185"
              y="125"
              width="190"
              height="190"
              clip-path={`url(#icon-clip-${slug})`}
              preserveAspectRatio="xMidYMid slice"
            />
          </g>
        ) : (
          <text
            x="280"
            y="280"
            text-anchor="middle"
            font-size="180"
            font-family="Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji, sans-serif"
          >
            {icon}
          </text>
        )}

        {/* 右上角小标签 */}
        <g transform="translate(560, 50)">
          <rect width="180" height="40" rx="20" fill="white" opacity="0.7" />
          <text
            x="90"
            y="26"
            text-anchor="middle"
            font-size="20"
            font-family="Inter, sans-serif"
            fill="#4A3C2E"
            font-weight="500"
          >
            {title}
          </text>
        </g>

        {/* 高光 */}
        <rect
          x="0"
          y="0"
          width="400"
          height="450"
          fill={`url(#shine-${slug})`}
          opacity="0.4"
        />
      </svg>
    )
  }
</div>

<style>
  .app-cover {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: theme('colors.cream.100');
  }
  .app-cover--16x9 {
    aspect-ratio: 16 / 9;
  }
  .app-cover--3x2 {
    aspect-ratio: 3 / 2;
  }
  .app-cover svg,
  .app-cover .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .cover-img {
    object-fit: cover;
  }
</style>