---
interface Props {
  series?: string;
  /** 标题文本 */
  title?: string;
  /** 副标题文本 */
  subtitle?: string;
  /** 计数器，例如 "6 个 app" */
  count?: string;
}

const { series, title, subtitle, count } = Astro.props;
---

<section class="series-backdrop">
  <svg viewBox="0 0 1200 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id="series-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--cover-a)" />
        <stop offset="100%" stop-color="var(--cover-b)" />
      </linearGradient>
      <radialGradient id="series-glow" cx="80%" cy="20%" r="60%">
        <stop offset="0%" stop-color="var(--cover-accent)" stop-opacity="0.35" />
        <stop offset="100%" stop-color="var(--cover-accent)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="series-glow-2" cx="15%" cy="80%" r="50%">
        <stop offset="0%" stop-color="var(--cover-accent)" stop-opacity="0.2" />
        <stop offset="100%" stop-color="var(--cover-accent)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="1200" height="320" fill="url(#series-bg)" />
    <rect width="1200" height="320" fill="url(#series-glow)" />
    <rect width="1200" height="320" fill="url(#series-glow-2)" />

    {/* 柔和圆点 */}
    <g fill="currentColor" opacity="0.16">
      <circle cx="180" cy="80" r="3" />
      <circle cx="320" cy="220" r="2" />
      <circle cx="450" cy="60" r="2.5" />
      <circle cx="600" cy="180" r="2" />
      <circle cx="780" cy="100" r="3" />
      <circle cx="920" cy="240" r="2" />
      <circle cx="1080" cy="80" r="2.5" />
    </g>

    {/* 抽象弧线 */}
    <path
      d="M 0 220 Q 300 160 600 220 T 1200 220"
      stroke="var(--cover-accent)"
      stroke-width="1.5"
      fill="none"
      opacity="0.3"
    />
    <path
      d="M 0 250 Q 300 200 600 250 T 1200 250"
      stroke="var(--cover-accent)"
      stroke-width="1"
      fill="none"
      opacity="0.2"
    />
  </svg>

  {(title || subtitle || count) && (
    <div class="series-content container-narrow">
      {count && <span class="series-count">{count}</span>}
      {title && <h2 class="series-title">{title}</h2>}
      {subtitle && <p class="series-subtitle">{subtitle}</p>}
    </div>
  )}
</section>

<style>
  .series-backdrop {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    margin: 0 1.5rem;
    max-width: 1100px;
    margin-inline: auto;
  }
  .series-backdrop svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .series-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
  }
  .series-count {
    background: var(--glass-strong);
    color: theme('colors.ink.800');
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .series-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 0.5rem;
    color: theme('colors.ink.900');
  }
  .series-subtitle {
    color: theme('colors.ink.700');
    font-size: 1.05rem;
    margin: 0;
    max-width: 50ch;
  }
</style>