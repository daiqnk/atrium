---
import { withBase, stripBase, absUrl } from '@/utils/paths';
import { getLocaleFromUrl, bareSlug } from '@/i18n/utils';
import { word } from '@/i18n/labels';
import AppCover from './AppCover.astro';
import Badge from './ui/Badge.astro';
import Tag from './ui/Tag.astro';
import Chip from './ui/Chip.astro';

interface Props {
  slug: string;
  title: string;
  subtitle?: string;
  description: string;
  icon: string;
  category: string;
  series?: string;
  tags: string[];
  status?: string;
  platforms: string[];
  featured?: boolean;
  order?: number;
  cover?: string;
  iconImage?: string;
  accentColor?: string;
}

const {
  slug,
  title,
  subtitle,
  description,
  icon,
  category,
  series,
  tags,
  status = 'live',
  platforms,
  featured = false,
  cover,
  iconImage,
  accentColor,
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
// entry.slug 可能是 `zh/wilume`，统一剥掉目录前缀再拼链接
const key = bareSlug(slug);
const href = locale === 'en' ? `/en/apps/${key}` : `/apps/${key}`;
---

<a href={withBase(href)} class="card app-card h-full" data-no-lang-switch>
  <div class="cover-wrap">
    <AppCover
      slug={key}
      icon={icon}
      title={title}
      series={series}
      accentColor={accentColor}
      aspect={1}
      src={cover}
      iconImage={iconImage}
    />
    <div class="badges">
      {featured && <Badge kind="featured" />}
      {/* 状态恒定展示：不因 live 而隐藏，避免用户只能通过颜色猜状态 */}
      <Badge kind="status" status={status} />
    </div>
  </div>

  <div class="card-body">
    <div class="app-head">
      <div class="app-icon" aria-hidden="true">{iconImage ? <img src={withBase(iconImage)} alt="" class="app-icon-img" loading="lazy" /> : icon}</div>
      <div class="app-meta">
        <span class="app-category">{category}</span>
        {series && <Badge kind="series" series={series} />}
      </div>
    </div>
    <h3 class="app-title">{title}</h3>
    {subtitle && <p class="app-subtitle">{subtitle}</p>}
    <p class="app-desc">{description}</p>
    {tags.length > 0 && (
      <div class="app-tags">
        {tags.slice(0, 3).map((t) => <Tag text={t} />)}
      </div>
    )}
    <div class="app-foot">
      <div class="app-platforms">
        {platforms.map((p) => <Chip kind="platform" platform={p} />)}
      </div>
      <span class="card-cta">{word('view', locale)} <span class="cta-arrow" aria-hidden="true">→</span></span>
    </div>
  </div>
</a>

<style>
  .app-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 260ms ease;
  }
  .app-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px -12px rgba(74, 60, 46, 0.22);
  }

  .cover-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .badges {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.35rem;
  }

  .card-body {
    padding: 1.1rem 1.35rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }
  .app-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 1.85rem;
  }
  .app-icon {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: theme('colors.rose.50');
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }
  .app-icon-img {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }
  .app-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }
  .app-category {
    color: theme('colors.ink.700');
    font-size: 0.8rem;
  }
  .app-title {
    margin: 0.1rem 0 0;
    font-size: 1.18rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .app-subtitle {
    margin: 0;
    color: theme('colors.ink.700');
    font-size: 0.8rem;
    font-style: italic;
    opacity: 0.7;
  }
  .app-desc {
    color: theme('colors.ink.700');
    font-size: 0.9rem;
    margin: 0.15rem 0 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.35rem;
  }
  .app-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px dashed theme('colors.cream.200');
  }
  .app-platforms {
    display: flex;
    gap: 0.28rem;
    flex-wrap: wrap;
  }
  .card-cta {
    color: theme('colors.rose.300');
    font-size: 0.82rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .cta-arrow {
    transition: transform 200ms ease;
  }
  .app-card:hover .cta-arrow {
    transform: translateX(3px);
  }
</style>