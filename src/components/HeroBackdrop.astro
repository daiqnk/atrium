---
/**
 * 首页 hero 区背景动画：漂浮光斑 + 渐变
 * prefers-reduced-motion 友好的：禁用动画
 */
---

<div class="hero-backdrop" aria-hidden="true">
  <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="h-glow-1" cx="20%" cy="20%" r="40%">
        <stop offset="0%" stop-color="#F4C2C2" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#F4C2C2" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="h-glow-2" cx="80%" cy="70%" r="35%">
        <stop offset="0%" stop-color="#9CAF88" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#9CAF88" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="h-glow-3" cx="60%" cy="20%" r="30%">
        <stop offset="0%" stop-color="#E0BFB8" stop-opacity="0.32" />
        <stop offset="100%" stop-color="#E0BFB8" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="1200" height="600" fill="transparent" />
    <rect width="1200" height="600" fill="url(#h-glow-1)" />
    <rect width="1200" height="600" fill="url(#h-glow-2)" />
    <rect width="1200" height="600" fill="url(#h-glow-3)" />

    {/* 漂浮光斑 */}
    <g class="floaters">
      <circle class="floater f1" cx="160" cy="120" r="6" fill="#F4C2C2" opacity="0.7" />
      <circle class="floater f2" cx="320" cy="380" r="4" fill="#9CAF88" opacity="0.6" />
      <circle class="floater f3" cx="940" cy="180" r="5" fill="#E0BFB8" opacity="0.7" />
      <circle class="floater f4" cx="1080" cy="420" r="4" fill="#F4C2C2" opacity="0.5" />
      <circle class="floater f5" cx="540" cy="80" r="3" fill="#9CAF88" opacity="0.5" />
      <circle class="floater f6" cx="760" cy="500" r="3.5" fill="#E0BFB8" opacity="0.5" />
      <circle class="floater f7" cx="220" cy="500" r="2.5" fill="#F4C2C2" opacity="0.5" />
      <circle class="floater f8" cx="1020" cy="80" r="3" fill="#9CAF88" opacity="0.6" />
    </g>

    {/* 弧形装饰 */}
    <path
      d="M -50 480 Q 300 420 600 500 T 1250 480"
      stroke="#9CAF88"
      stroke-width="1.2"
      fill="none"
      opacity="0.25"
    />
    <path
      d="M -50 510 Q 300 460 600 530 T 1250 510"
      stroke="#F4C2C2"
      stroke-width="1"
      fill="none"
      opacity="0.2"
    />
  </svg>
</div>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .hero-backdrop svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .floater {
    animation: float 12s ease-in-out infinite;
    transform-origin: center;
  }
  .f1 { animation-delay: 0s; }
  .f2 { animation-delay: 1.5s; animation-duration: 14s; }
  .f3 { animation-delay: 3s; animation-duration: 11s; }
  .f4 { animation-delay: 2s; animation-duration: 13s; }
  .f5 { animation-delay: 4s; animation-duration: 10s; }
  .f6 { animation-delay: 5s; animation-duration: 12s; }
  .f7 { animation-delay: 1s; animation-duration: 15s; }
  .f8 { animation-delay: 2.5s; animation-duration: 11s; }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0);
      opacity: var(--start-op, 0.6);
    }
    50% {
      transform: translate(8px, -14px);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floater {
      animation: none;
    }
  }
</style>