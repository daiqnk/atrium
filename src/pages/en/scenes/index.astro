---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import RevealOnScroll from '@/components/ui/RevealOnScroll.astro';
import SceneCard from '@/components/SceneCard.astro';
import { getDict } from '@/i18n/utils';
import { scenes } from '@/data/scenes';

const dict = getDict('en');
const locale = 'en' as const;
---

<BaseLayout title={`Scenes · ${dict.siteName}`} description="Find the right app, knowledge and practice for how you feel right now.">
  <section class="container-narrow section-air">
    <RevealOnScroll>
      <PageHeader
        eyebrow="Scenes"
        title="What kind of headspace are you in?"
        description="Stress less, sleep soundly, find focus — come in by how you feel, not by a menu."
        size="lg"
      />
    </RevealOnScroll>

    <div class="scene-grid">
      {scenes.map((scene, i) => (
        <RevealOnScroll y={20} delay={i * 90}>
          <SceneCard scene={scene} locale={locale} />
        </RevealOnScroll>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .scene-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }
</style>
