---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import RevealOnScroll from '@/components/ui/RevealOnScroll.astro';
import { getDict } from '@/i18n/utils';
import { tpl } from '@/i18n/labels';

const dict = getDict('en');
const all = await getCollection('knowledge', ({ data }) => data.locale === 'en');
const items = all.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title={`${dict.sectionKnowledgeTitle} · ${dict.siteName}`}
  description={dict.sectionKnowledgeDesc}
>
  <section class="container-narrow pt-12 pb-24">
    <RevealOnScroll>
      <PageHeader
        eyebrow={tpl(dict.countArticles, { n: items.length })}
        title={dict.sectionKnowledgeTitle}
        description={dict.sectionKnowledgeDesc}
      />
    </RevealOnScroll>

    <div class="grid md:grid-cols-2 gap-5">
      {
        items.map((entry, i) => (
          <RevealOnScroll y={18} delay={i * 80} class="h-full">
            <ArticleCard
              slug={entry.slug}
              title={entry.data.title}
              description={entry.data.description}
              category={entry.data.category}
              tags={entry.data.tags}
              publishedAt={entry.data.publishedAt}
              readingTime={entry.data.readingTime}
              variant="knowledge"
            />
          </RevealOnScroll>
        ))
      }
    </div>
  </section>
</BaseLayout>
