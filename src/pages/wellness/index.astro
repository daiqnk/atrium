---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import RevealOnScroll from '@/components/ui/RevealOnScroll.astro';
import { getDict } from '@/i18n/utils';
import { tpl, normalizeDifficulty } from '@/i18n/labels';

const dict = getDict('zh');
const all = await getCollection('wellness', ({ data }) => data.locale === 'zh');
// 排序：先按难度（轻松 → 适中 → 需投入），同级按日期降序
const diffRank = { easy: 0, medium: 1, hard: 2 } as const;
const items = all.sort((a, b) => {
  const da = diffRank[normalizeDifficulty(a.data.difficulty)];
  const db = diffRank[normalizeDifficulty(b.data.difficulty)];
  if (da !== db) return da - db;
  return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
});
---

<BaseLayout
  title={`${dict.sectionWellnessTitle} · ${dict.siteName}`}
  description={dict.sectionWellnessDesc}
>
  <section class="container-narrow pt-12 pb-24">
    <RevealOnScroll>
      <PageHeader
        eyebrow={tpl(dict.countPractices, { n: items.length })}
        title={dict.sectionWellnessTitle}
        description={dict.sectionWellnessDesc}
      />
    </RevealOnScroll>

    <div class="grid md:grid-cols-2 gap-5">
      {
        items.map((entry, i) => (
          <RevealOnScroll y={18} delay={i * 80} class="h-full">
            <ArticleCard
              slug={entry.slug}
              title={entry.data.title}
              description={entry.data.description}
              category={entry.data.category}
              tags={[]}
              publishedAt={entry.data.publishedAt}
              variant="wellness"
              duration={entry.data.duration}
              difficulty={entry.data.difficulty}
            />
          </RevealOnScroll>
        ))
      }
    </div>
  </section>
</BaseLayout>
